OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here

ZOTERO_MCP_URL=http://127.0.0.1:23120/mcp
ZOTERO_MCP_BASE_URL=http://127.0.0.1:23120
# ZOTERO_EXE is optional.
# When unset, defaults by platform:
#   darwin:  /Applications/Zotero.app/Contents/MacOS/zotero
#   win32:   D:/Zotero/zotero.exe
#   linux:   zotero (from PATH)
# Override examples:
#   Windows: ZOTERO_EXE=D:/Zotero/zotero.exe
#   macOS:   ZOTERO_EXE=/Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_EXE=

ZOTERO_PROJECT_ROOT=.
DESKTOP_REVIEW_ROOT=./research_os/文献评价
RESEARCH_OS_RUN_INTERVAL_DAYS=2
ZOTERO_TRANSLATION_POOL_SCAN_INTERVAL_DAYS=4
ZOTERO_TRANSLATION_POOL_SCAN_WINDOW_DAYS=4
# Default: use pwsh from PATH.
# macOS Apple Silicon Homebrew example: /opt/homebrew/bin/pwsh
# macOS Intel Homebrew example: /usr/local/bin/pwsh
PWSH_PATH=pwsh
PYTHON_PATH=python

TITLE_TRANSLATION_API_KEY=your_translation_api_key_here
TITLE_TRANSLATION_ENDPOINT=https://api.example.com/v1
TITLE_TRANSLATION_MODEL=mimo-v2.5-pro
TITLE_TRANSLATION_BATCH_SIZE=30
TITLE_TRANSLATION_TEMPERATURE=0

# Optional. If omitted, preference learning falls back to TITLE_TRANSLATION_API_KEY.
PREFERENCE_LEARNING_API_KEY=

