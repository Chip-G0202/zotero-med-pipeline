OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here

ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_LIBRARY_ID=your_zotero_library_id_here
ZOTERO_LIBRARY_TYPE=user_or_group
ZOTERO_MCP_URL=http://127.0.0.1:23120/mcp
ZOTERO_MCP_BASE_URL=http://127.0.0.1:23120
ZOTERO_EXE=D:/Zotero/zotero.exe

ZOTERO_PROJECT_ROOT=.
DESKTOP_REVIEW_ROOT=./research_os/desktop_review
PWSH_PATH=pwsh
PYTHON_PATH=python

TITLE_TRANSLATION_API_KEY=your_translation_api_key_here
TITLE_TRANSLATION_ENDPOINT=https://your-api-endpoint.com/v1
TITLE_TRANSLATION_MODEL=your-model-name
TITLE_TRANSLATION_BATCH_SIZE=30
TITLE_TRANSLATION_TEMPERATURE=0

# Optional. If omitted, preference learning falls back to TITLE_TRANSLATION_API_KEY.
PREFERENCE_LEARNING_API_KEY=

