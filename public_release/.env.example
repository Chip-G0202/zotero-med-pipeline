OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

ZOTERO_API_KEY=YOUR_ZOTERO_API_KEY
ZOTERO_LIBRARY_ID=YOUR_ZOTERO_LIBRARY_ID
ZOTERO_LIBRARY_TYPE=user_or_group
# Zotero MCP server address. Default: http://127.0.0.1:23120/mcp
# If your Zotero MCP plugin uses a different port, update this accordingly.
ZOTERO_MCP_URL=http://127.0.0.1:23120/mcp
ZOTERO_MCP_BASE_URL=http://127.0.0.1:23120

# ZOTERO_EXE is optional.
# When unset, the system attempts to use platform-specific defaults or environment paths.
#   Windows example: D:/Zotero/zotero.exe or C:/Program Files/Zotero/zotero.exe
#   macOS example:   /Applications/Zotero.app (launches app) or /Applications/Zotero.app/Contents/MacOS/zotero
#   Linux example:   zotero (if in PATH)
# Uncomment and set if auto-detection fails or you have multiple Zotero installations.
# ZOTERO_EXE=

ZOTERO_PROJECT_ROOT=.
DESKTOP_REVIEW_ROOT=./research_os/desktop_review
# Default: use pwsh from PATH.
# macOS Apple Silicon Homebrew example: /opt/homebrew/bin/pwsh
# macOS Intel Homebrew example: /usr/local/bin/pwsh
PWSH_PATH=pwsh
PYTHON_PATH=python

TITLE_TRANSLATION_API_KEY=YOUR_TRANSLATION_API_KEY
TITLE_TRANSLATION_ENDPOINT=YOUR_TRANSLATION_ENDPOINT
TITLE_TRANSLATION_MODEL=YOUR_TRANSLATION_MODEL
TITLE_TRANSLATION_BATCH_SIZE=30
TITLE_TRANSLATION_TEMPERATURE=0

# Optional. If omitted, preference learning falls back to TITLE_TRANSLATION_API_KEY.
PREFERENCE_LEARNING_API_KEY=
